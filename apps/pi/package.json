{
	"name": "pi-supabase-extension",
	"version": "0.0.0",
	"description": "Read, start, stop, and open the local Supabase stack from pi.",
	"license": "MIT",
	"type": "module",
	"files": [
		"dist"
	],
	"keywords": [
		"supabase",
		"pi-package"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/FrediLehmann/supabase-agent-extension",
		"directory": "apps/pi"
	},
	"scripts": {
		"build": "bun build src/index.ts --outdir dist --target=node --format=esm --external @earendil-works/pi-coding-agent",
		"prepack": "bun run build"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "^1.5.2"
	},
	"devDependencies": {
		"@earendil-works/pi-coding-agent": "^1.5.2",
		"@supabase-agent-extension/supabase": "workspace:*",
		"@types/bun": "catalog:",
		"@types/node": "catalog:"
	},
	"pi": {
		"extensions": [
			"./dist/index.js"
		]
	}
}
