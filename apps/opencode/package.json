{
	"name": "opencode-supabase-extension",
	"version": "0.0.0",
	"description": "Show, start, stop, and open the local Supabase stack in OpenCode.",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": "./dist/index.js",
		"./tui": "./dist/tui.js",
		"./gui-experimental": "./dist/gui-experimental.cjs"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"supabase",
		"opencode-plugin"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/FrediLehmann/supabase-agent-extension",
		"directory": "apps/opencode"
	},
	"scripts": {
		"build": "bun run build:server && bun run build:tui && bun run build:gui",
		"build:server": "bun build src/index.ts --outdir dist --target=bun --format=esm --external '@opencode/plugin' --external '@opencode/plugin/*' --external effect --external 'effect/*'",
		"build:tui": "bun build.tui.ts",
		"build:gui": "vite build",
		"dev": "bun run build:server --watch & bun build.tui.ts --watch & vite build --watch",
		"prepack": "bun run build"
	},
	"peerDependencies": {
		"@opencode/plugin": "^2.2.7",
		"@opentui/core": ">=0.8.1",
		"@opentui/solid": ">=0.8.1",
		"solid-js": ">=1.9.0"
	},
	"devDependencies": {
		"@opencode/plugin": "^2.2.7",
		"@opentui/core": "0.8.1",
		"@opentui/solid": "0.8.1",
		"@supabase-agent-extension/assets": "workspace:*",
		"@supabase-agent-extension/supabase": "workspace:*",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"solid-js": "^1.9.17",
		"vite": "^7.3.7",
		"vite-plugin-solid": "^2.11.10"
	}
}
